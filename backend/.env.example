# mail.com 后端配置
MAILCOM_DB_PATH=./data/mailcom.db
MAILCOM_SECRET_KEY=dev-secret-key-please-change-32bytes-minimum
JWT_SECRET=dev-jwt-secret-please-change-32bytes-minimum
JWT_EXPIRE_MINUTES=1440
PICKUP_API_BASE=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
MAILCOM_TIMEOUT=30
MAX_ALIASES_PER_ACCOUNT=10
PICKUP_CONCURRENCY_PER_ACCOUNT=2
PICKUP_GLOBAL_CONCURRENCY=8
RATE_LIMIT_PER_ACCOUNT_QPS=1
RATE_LIMIT_GLOBAL_QPS=5
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
CIRCUIT_FAIL_THRESHOLD=5
CIRCUIT_COOLDOWN=60
PICKUP_CACHE_TTL=30
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
FRONTEND_DIST=../frontend/dist
